def draw_maze(screen, maze, player_row, player_column, buttons=(), gate_slide_started_at=None, level_three=False, floor_texture=None, pillars=(), torches=(), carried_torch=False):
    """Draw a rocky cave maze with a dim, mottled stone floor."""
    maze_width = max(len(row) for row in maze) * CELL_SIZE
    maze_height = len(maze) * CELL_SIZE
    offset_x = (WINDOW_WIDTH - maze_width) // 2
    offset_y = (WINDOW_HEIGHT - maze_height) // 2

    floor_color = LEVEL_THREE_FLOOR if level_three else CAVE_FLOOR
    floor_flecks = LEVEL_THREE_FLOOR_FLECKS if level_three else FLOOR_FLECKS
    stone_shades = LEVEL_THREE_STONE_SHADES if level_three else STONE_SHADES
    stone_highlight = LEVEL_THREE_STONE_HIGHLIGHT if level_three else STONE_HIGHLIGHT
    stone_shadow = LEVEL_THREE_STONE_SHADOW if level_three else STONE_SHADOW
    if level_three and floor_texture is not None:
        screen.blit(floor_texture, (0, 0))
    else:
        screen.fill(floor_color)

    # Floor details give each cave section its own atmosphere.
    if level_three and floor_texture is None:
        # Irregular low-contrast chips make the floor read as grey cave rock.
        for i in range(190):
            x = (i * 191 + 37) % WINDOW_WIDTH
            y = (i * 113 + 59) % WINDOW_HEIGHT
            color = floor_flecks[i % len(floor_flecks)]
            width = 2 + i % 5
            height = 1 + (i // 3) % 3
            pygame.draw.ellipse(screen, color, (x, y, width, height))
            if i % 5 == 0:
                highlight = LEVEL_THREE_ROCK_HIGHLIGHTS[(i // 5) % len(LEVEL_THREE_ROCK_HIGHLIGHTS)]
                pygame.draw.line(screen, highlight, (x, y), (x + width, y), 1)
    elif not level_three:
        # Subtle floor speckles make the original cave feel like rough stone.
        for i in range(260):
            x = (i * 191 + 37) % WINDOW_WIDTH
            y = (i * 113 + 59) % WINDOW_HEIGHT
            pygame.draw.circle(screen, floor_flecks[i % len(floor_flecks)], (x, y), 1 + (i % 3 == 0))

    for row, line in enumerate(maze):
        for column, tile in enumerate(line):
            x = offset_x + column * CELL_SIZE
            y = offset_y + row * CELL_SIZE

            if tile == "#":
                wall_y = y
                is_gate = (row, column) == GATE_TILE
                if is_gate and gate_slide_started_at is not None:
                    elapsed = pygame.time.get_ticks() - gate_slide_started_at
                    slide = min(CELL_SIZE, int(CELL_SIZE * elapsed / GATE_SLIDE_DURATION))
                    if slide >= CELL_SIZE:
                        continue
                    wall_y += slide
                    previous_clip = screen.get_clip()
                    screen.set_clip(pygame.Rect(x, y, CELL_SIZE, CELL_SIZE))
                shade = stone_shades[(row * 7 + column * 11) % len(stone_shades)]
                pygame.draw.rect(
                    screen,
                    stone_shadow,
                    (x + WALL_INSET, wall_y + WALL_INSET, CELL_SIZE - 2 * WALL_INSET, CELL_SIZE - 2 * WALL_INSET),
                )
                pygame.draw.rect(screen, shade, (x + 2, wall_y + 2, CELL_SIZE - 4, CELL_SIZE - 4))
                pygame.draw.line(screen, stone_highlight, (x + 2, wall_y + 2), (x + CELL_SIZE - 3, wall_y + 2), 2)
                pygame.draw.line(screen, stone_highlight, (x + 2, wall_y + 2), (x + 2, wall_y + CELL_SIZE - 3), 2)
                pygame.draw.line(screen, stone_shadow, (x + CELL_SIZE - 2, wall_y + 3), (x + CELL_SIZE - 2, wall_y + CELL_SIZE - 3), 2)
                pygame.draw.line(screen, stone_shadow, (x + 3, wall_y + CELL_SIZE - 2), (x + CELL_SIZE - 3, wall_y + CELL_SIZE - 2), 2)
                if (row * 13 + column * 5) % 9 == 0:
                    pygame.draw.line(screen, stone_shadow, (x + 8, wall_y + 8), (x + 12, wall_y + 13), 1)
                    pygame.draw.line(screen, stone_shadow, (x + 12, wall_y + 13), (x + 16, wall_y + 10), 1)
                if is_gate and gate_slide_started_at is not None:
                    screen.set_clip(previous_clip)
            elif tile == ".":
                pygame.draw.circle(screen, DOT, (x + CELL_SIZE // 2, y + CELL_SIZE // 2), 3)

    for row, column in pillars:
        draw_pillar(screen, column * CELL_SIZE, row * CELL_SIZE)

    for row, column, wall_side in torches:
        draw_torch(screen, column * CELL_SIZE, row * CELL_SIZE, wall_side)

    for button in buttons:
        row, column = button["wall"]
        x = column * CELL_SIZE
        y = row * CELL_SIZE
        pygame.draw.rect(screen, BUTTON_SHADOW, (x + 5, y + 7, 15, 14))
        pygame.draw.rect(screen, BUTTON_OUTLINE, (x + 6, y + 5, 13, 13))
        if button["pressed"]:
            pygame.draw.rect(screen, BUTTON_RIM, (x + 8, y + 7, 9, 9))
            pygame.draw.rect(screen, BUTTON_DARK, (x + 9, y + 9, 7, 6))
            pygame.draw.rect(screen, BUTTON_LIGHT, (x + 10, y + 10, 3, 2))
            pygame.draw.rect(screen, BUTTON_SHADOW, (x + 9, y + 14, 7, 2))
        else:
            pygame.draw.rect(screen, BUTTON_RIM, (x + 7, y + 6, 11, 11))
            pygame.draw.rect(screen, BUTTON_DARK, (x + 8, y + 7, 9, 9))
            pygame.draw.rect(screen, BUTTON_LIGHT, (x + 9, y + 7, 7, 7))
            pygame.draw.rect(screen, BUTTON_HIGHLIGHT, (x + 9, y + 8, 3, 2))
            pygame.draw.rect(screen, BUTTON_SHADOW, (x + 8, y + 14, 9, 2))

    # Keep the character fully inside and centred on its current maze tile.
    draw_character(
        screen,
        player_column * CELL_SIZE + 1,
        player_row * CELL_SIZE + 2,
    )
    if carried_torch:
        draw_carried_torch(screen, player_column * CELL_SIZE, player_row * CELL_SIZE)


