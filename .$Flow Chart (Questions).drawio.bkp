  <diagram name="2 - Question and Subdifficulty Flow" id="questions">
    <mxGraphModel dx="1450" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="QUESTION ROUTINE — used by every level-completion checkpoint" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="260" y="30" width="900" height="45" as="geometry" />
        </mxCell>
        <mxCell id="trigger" value="Question required&#xA;Level completion, death, or maze transition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="545" y="100" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="is_level_end" value="Is this a&#xA;level-completion question?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="550" y="205" width="210" height="105" as="geometry" />
        </mxCell>
        <mxCell id="pick" value="Player chooses main difficulty&#xA;Easy · Medium · Hard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="160" y="220" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="active" value="Use the currently active main difficulty&#xA;(death or Level 5 maze check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="220" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="setmain" value="Store/use this main difficulty&#xA;for the question sequence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="525" y="345" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="firsttime" value="Has a subdifficulty&#xA;been set before?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="555" y="460" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="initmedium" value="FIRST QUESTION&#xA;Initialize subdifficulty to Medium&#xA;inside the chosen main group&#xA;(e.g. Hard-Medium)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="160" y="465" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="prevwrong" value="For this new question:&#xA;Was the previous answer wrong?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="610" width="230" height="115" as="geometry" />
        </mxCell>
        <mxCell id="lower" value="YES — lower subdifficulty&#xA;one step, within the chosen main group&#xA;Hard → Medium → Easy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="615" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="keep" value="NO — keep the current subdifficulty&#xA;(do not lower it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="160" y="620" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ask" value="Ask question using:&#xA;chosen main difficulty + selected subdifficulty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="525" y="790" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="correct" value="Answer&#xA;correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="565" y="925" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="wrong" value="NO — record previous answer = WRONG&#xA;Keep the pending action; do not advance/revive/enter yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="875" y="935" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="done" value="YES — record previous answer = CORRECT&#xA;Complete the pending action: advance level, revive,&#xA;or enter/leave the Level 5 maze" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="405" y="1080" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="floor" value="SUBDIFFICULTY FLOOR&#xA;If the chosen group is Easy and the subdifficulty is already Easy, another wrong answer keeps it at Easy-Easy. It cannot go lower." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;size=18;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="1080" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b1" edge="1" parent="1" source="trigger" target="is_level_end" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b1a" edge="1" parent="1" source="is_level_end" target="pick" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b1b" edge="1" parent="1" source="is_level_end" target="active" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2a" edge="1" parent="1" source="active" target="setmain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="815" y="325" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b2" edge="1" parent="1" source="pick" target="setmain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b3" edge="1" parent="1" source="setmain" target="firsttime" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b4" edge="1" parent="1" source="firsttime" target="initmedium" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b5" edge="1" parent="1" source="firsttime" target="prevwrong" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b6" edge="1" parent="1" source="initmedium" target="ask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="295" y="830" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b7" edge="1" parent="1" source="prevwrong" target="lower" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b8" edge="1" parent="1" source="prevwrong" target="keep" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b9" edge="1" parent="1" source="lower" target="ask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1045" y="755" />
              <mxPoint x="795" y="755" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b10" edge="1" parent="1" source="keep" target="ask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="295" y="755" />
              <mxPoint x="500" y="755" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b11" edge="1" parent="1" source="ask" target="correct" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b12" edge="1" parent="1" source="correct" target="wrong" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
