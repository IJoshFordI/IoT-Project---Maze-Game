        <mxCell id="b14" edge="1" parent="1" source="correct" target="done" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="combinations" value="ALL MAIN / SUBDIFFICULTY PAIRS&amp;#10;&amp;#10;Easy group: Easy-Easy · Easy-Medium · Easy-Hard&amp;#10;Medium group: Medium-Easy · Medium-Medium · Medium-Hard&amp;#10;Hard group: Hard-Easy · Hard-Medium · Hard-Hard" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;size=18;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="900" width="390" height="155" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 - Death and Level 5 Maze Checks" id="special-triggers">
    <mxGraphModel dx="1450" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="EXTRA QUESTION GATES — both use the Question Flow on page 2" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="950" height="45" as="geometry" />
        </mxCell>
        <mxCell id="playing" value="Player is playing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="death" value="Did the player die?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="575" y="205" width="190" height="105" as="geometry" />
        </mxCell>
        <mxCell id="whichlevel" value="Which level was the player on?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="545" y="360" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="reset45" value="Level 4 or Level 5&#xA;Reset the entire level before revival&#xA;(Level 5 reset includes North, East, and West mazes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="365" width="350" height="95" as="geometry" />
        </mxCell>
        <mxCell id="resetother" value="Level 1, 2, or 3&#xA;Apply that level's normal death reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="115" y="375" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="revivepending" value="Set pending action: REVIVE&#xA;Player remains dead until the answer is correct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="535" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mazecheck" value="On Level 5: is the player&#xA;entering or leaving North, East, or West maze?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="690" width="260" height="115" as="geometry" />
        </mxCell>
        <mxCell id="mazepending" value="Set pending action: ENTER or EXIT maze&#xA;Do not cross the maze boundary yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="705" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="useengine" value="Run Question Flow (page 2)&#xA;Use the active main and subdifficulty&#xA;Correct → finish pending action&#xA;Wrong → lower subdifficulty and retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="700" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="continue" value="No death and no maze transition&amp;#10;Continue playing the current level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="950" y="535" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pendingaction" value="Which action is waiting?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="845" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="afterrevive" value="REVIVE action&#xA;Revive player at the reset/current level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="1010" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="aftermaze" value="MAZE action&#xA;Allow the requested maze entry or exit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="760" y="1010" width="350" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c1" edge="1" parent="1" source="playing" target="death" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
