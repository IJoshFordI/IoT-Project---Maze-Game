        <mxCell id="b13" edge="1" parent="1" source="wrong" target="prevwrong" value="Next new question: check again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1035" y="1040" />
              <mxPoint x="810" y="1040" />
              <mxPoint x="810" y="670" />
